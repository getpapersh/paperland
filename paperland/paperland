#!/usr/bin/env bash
set -euo pipefail

paperland_dir=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
load_input_bridge() {
  local binary="$paperland_dir/native/MinimapInput.so"
  local stamp="$paperland_dir/native/MinimapInput.version"
  if [[ ! -f "$binary" || ! -f "$stamp" ]]; then
    echo "Paperland input bridge is unavailable; reinstall Paperland to enable Super-click. Click, pill, grip, and badge controls remain available. Canvas pan needs verified direction while monitor-aware integration is on." >&2
    return 0
  fi
  local built_abi runtime runtime_abi plugins
  built_abi=$(<"$stamp")
  runtime=$(hyprctl version 2>/dev/null) || {
    echo "Paperland could not check the Hyprland build; the input bridge was not loaded." >&2
    return 0
  }
  runtime_abi=$(sed -n 's/^Version ABI string: //p' <<< "$runtime")
  if [[ "$runtime_abi" != "$built_abi" ]]; then
    echo "Paperland input bridge is for another Hyprland build; reinstall Paperland to enable Super-click." >&2
    return 0
  fi
  plugins=$(hyprctl plugin list 2>/dev/null) || {
    echo "Paperland could not inspect Hyprland plugins; the input bridge was not loaded." >&2
    return 0
  }
  if [[ "$plugins" == *"Plugin Paperland minimap input by Paperland:"* ]]; then
    if [[ "$plugins" != *"Version: $built_abi"* ]]; then
      echo "An older Paperland input bridge is loaded; restart Hyprland before using Super-click." >&2
    fi
    return 0
  fi
  hyprctl plugin load "$binary" >/dev/null || echo "Paperland input bridge could not load; click, pill, grip, and badge controls remain available. Canvas pan needs verified direction while monitor-aware integration is on." >&2
}
# Until a symlinked main config includes the new generated file, Hyprland still loads the old
# names file, so the name editor must keep writing there.
use_active_names_file() {
  local new="${XDG_STATE_HOME:-$HOME/.local/state}/paperland/hypr/paperland-workspace-names.lua"
  local old="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/paperland-workspace-names.lua"
  if [[ -z "${PAPERLAND_WORKSPACE_NAMES_FILE:-}" && ! -e "$new" && -e "$old" ]]; then
    export PAPERLAND_WORKSPACE_NAMES_FILE="$old"
  fi
}
action=${1:-start}
if (( $# )); then shift; fi
case "$action" in
  setup)
    setup_desktop_bridge=false
    generated_dir="${XDG_STATE_HOME:-$HOME/.local/state}/paperland/hypr"
    # The old file counts only while the new generated include does not exist yet.
    if [[ -f "$generated_dir/paperland-desktop-directions.lua" ]] \
      || [[ ! -f "$generated_dir/paperland.lua" && -f "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/paperland-desktop-directions.lua" ]]; then
      setup_desktop_bridge=true
    fi
    for setup_arg in "$@"; do
      case "$setup_arg" in --desktop-direction|--desktop-direction=*) setup_desktop_bridge=true ;; esac
    done
    if [[ "$setup_desktop_bridge" == true ]]; then
      for setup_arg in "$@"; do
        if [[ "$setup_arg" == "--apply" || "$setup_arg" == "--settings-apply" || "$setup_arg" == --settings-apply=* ]]; then
          load_input_bridge
          break
        fi
      done
    fi
    exec python3 "$paperland_dir/setup.py" "$action" "$@"
    ;;
  install|uninstall)
    exec python3 "$paperland_dir/setup.py" "$action" "$@"
    ;;
  config)
    exec python3 "$paperland_dir/config.py" "$@"
    ;;
  start)
    load_input_bridge
    use_active_names_file
    exec env QT_QUICK_CONTROLS_STYLE=Basic quickshell --no-duplicate -p "$paperland_dir/shell.qml" "$@"
    ;;
  start-hidden)
    load_input_bridge
    use_active_names_file
    exec env PAPERLAND_START_HIDDEN=1 QT_QUICK_CONTROLS_STYLE=Basic quickshell --no-duplicate -d -p "$paperland_dir/shell.qml" "$@"
    ;;
  demo)
    exec env QT_QUICK_CONTROLS_STYLE=Basic quickshell --no-duplicate -p "$paperland_dir/demo.qml" "$@"
    ;;
  show|hide|toggle|search|settings|welcome|status|peek|pin|follow|activate|pan|direction)
    exec quickshell ipc -p "$paperland_dir/shell.qml" call -- paperland "$action" "$@"
    ;;
  instances)
    paperland_instances=$(quickshell list -p "$paperland_dir/shell.qml" --json) || exit $?
    # Quickshell 0.3 prints this text for an empty config even with --json.
    if [[ $paperland_instances == "No running instances for \"$paperland_dir/shell.qml\""$'\n'"Use --all to list all instances." ]]; then
      printf '[]\n'
    else
      printf '%s\n' "$paperland_instances"
    fi
    ;;
  switch-overlay)
    exec quickshell ipc -p "$paperland_dir/shell.qml" call -- paperland switchOverlay "$@"
    ;;
  stop-safe)
    exec quickshell ipc -p "$paperland_dir/shell.qml" call -- paperland requestStop
    ;;
  diagnostics)
    # Read-only: whether each host answers IPC, its running build identity
    # against a fresh hash of the installed files, and the standalone
    # runtime's classification of a fresh live bind query, polled quietly.
    if (( $# )); then
      echo "Usage: paperland diagnostics" >&2
      exit 2
    fi
    diagnostics_host() {
      local name=$1 label=$2 shell=$3 target=$4 running hash installed=null running_id=null result=unknown reason=""
      shift 4
      if hash=$("$paperland_dir/paperland" identity "$@" 2>/dev/null); then installed="\"$hash\""; else reason="Hashing the installed files failed."; fi
      if ! running=$(quickshell ipc -p "$shell" call -- "$target" identity 2>/dev/null) || [[ $running != '{'*'}' ]]; then
        # A runtime started before identity reporting still answers status.
        if quickshell ipc -p "$shell" call -- "$target" status >/dev/null 2>&1; then
          printf '"%s":{"reachable":true,"identity":{"result":"unknown","reason":"The running %s predates identity reporting; restart it.","running":null,"installed":%s}}' \
            "$name" "$label" "$installed"
        else
          printf '"%s":{"reachable":false,"reason":"The %s did not answer IPC.","identity":{"result":"unknown","reason":"No running identity without IPC.","running":null,"installed":%s}}' \
            "$name" "$label" "$installed"
        fi
        return
      fi
      if [[ $running =~ \"identity\":\"([0-9a-f]{16})\" ]]; then
        running_id="\"${BASH_REMATCH[1]}\""
      elif [[ -z $reason ]]; then
        # Lift the runtime's own JSON-escaped reason, such as "still being computed".
        if [[ $running =~ \"reason\":\"((\\.|[^\"\\])*)\" ]]; then reason=${BASH_REMATCH[1]}; else reason="The running identity is unavailable."; fi
      fi
      if [[ $running_id != null && $installed != null ]]; then
        [[ $running_id == "$installed" ]] && result=match || result=mismatch
      fi
      [[ $result == unknown ]] && reason=",\"reason\":\"$reason\"" || reason=
      printf '"%s":{"reachable":true,"identity":{"result":"%s"%s,"running":%s,"installed":%s}}' \
        "$name" "$result" "$reason" "$running_id" "$installed"
    }
    diagnostics_reply="{$(diagnostics_host standalone "standalone runtime" "$paperland_dir/shell.qml" paperland "$paperland_dir")"
    diagnostics_plugin="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/json.paperland"
    if [[ -e $diagnostics_plugin ]]; then
      diagnostics_reply+=",$(diagnostics_host bar "Omarchy bar host" "${OMARCHY_PATH:-/usr/share/omarchy}/shell/shell.qml" paperlandBar \
        "$diagnostics_plugin" "$diagnostics_plugin/paperland")"
    fi
    if quickshell ipc -p "$paperland_dir/shell.qml" call -- paperland status >/dev/null 2>&1; then
      diagnostics_shortcuts='{"incomplete":true,"reason":"The running standalone runtime predates bind diagnostics; restart it."}'
    else
      diagnostics_shortcuts='{"incomplete":true,"reason":"The standalone runtime did not answer IPC; live binds were not inspected."}'
    fi
    if diagnostics_request=$(quickshell ipc -p "$paperland_dir/shell.qml" call -- paperland diagnosticsBegin 2>/dev/null) \
        && [[ -n $diagnostics_request ]]; then
      # Microseconds; each IPC call takes time too, so the deadline is wall-clock.
      diagnostics_deadline=$(( ${EPOCHREALTIME//[^0-9]/} + 5000000 ))
      while :; do
        if ! diagnostics_status=$(quickshell ipc -p "$paperland_dir/shell.qml" call -- paperland diagnosticsStatus "$diagnostics_request" 2>/dev/null) \
            || [[ $diagnostics_status != '{'*'}' ]]; then
          diagnostics_shortcuts='{"incomplete":true,"reason":"The standalone runtime stopped answering IPC during the bind query."}'
          break
        fi
        if [[ $diagnostics_status != '{"pending":true}' ]]; then diagnostics_shortcuts=$diagnostics_status; break; fi
        if (( ${EPOCHREALTIME//[^0-9]/} >= diagnostics_deadline )); then
          diagnostics_shortcuts='{"incomplete":true,"reason":"The live bind query did not finish within 5 seconds."}'
          break
        fi
        sleep 0.1
      done
    fi
    printf '%s,"shortcuts":%s}\n' "$diagnostics_reply" "$diagnostics_shortcuts"
    ;;
  identity)
    # Internal plumbing for the hosts and `diagnostics`, not a public command.
    # Content hash of the runtime files a host loads: this launcher's tree, or
    # the given roots. Only the set the installer copies counts, so user config
    # (which lives outside these trees) and checkout extras never change it.
    # find -P never follows a symlink, so the plugin's `paperland -> ..` link
    # cannot loop or double-count; a root that is itself a link is resolved once.
    (( $# )) || set -- "$paperland_dir"
    identity_roots=()
    for identity_root in "$@"; do
      identity_resolved=$(readlink -e -- "$identity_root") || { echo "Identity root is missing: $identity_root" >&2; exit 1; }
      identity_roots+=("$identity_resolved")
    done
    for identity_index in "${!identity_roots[@]}"; do
      (
        cd -- "${identity_roots[$identity_index]}"
        {
          find -P . -maxdepth 1 -type f \( -name '*.qml' -o -name '*.js' -o -name qmldir -o -name paperland \
            -o -name setup.py -o -name manifest.json \) -print0
          for identity_dir in shared native lua fixtures omarchy plugin; do
            if [[ -d $identity_dir && ! -L $identity_dir ]]; then find -P "$identity_dir" -type f -print0; fi
          done
        } | LC_ALL=C sort -z | xargs -0 -r sha256sum -- | sed "s|  |  $identity_index/|"
      )
    done | sha256sum | cut -c1-16
    ;;
  captures)
    # One object keyed per host. The runtime treats anything but "detail" as
    # the privacy-preserving default, so a bare `captures` sends an explicit
    # empty argument. A host that does not answer is a coverage gap, never a
    # reconstructed list; the bar host is asked only when its plugin exists.
    if (( $# > 1 )) || [[ ${1:-} != "" && $1 != detail ]]; then
      echo "Usage: paperland captures [detail]" >&2
      exit 2
    fi
    captures_reply=$(quickshell ipc -p "$paperland_dir/shell.qml" call -- paperland captures "${1:-}" 2>/dev/null) || captures_reply=
    [[ $captures_reply == '{'*'}' ]] || captures_reply='{"standalone":{"reachable":false,"reason":"The standalone runtime did not answer IPC."}}'
    if [[ -e "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/json.paperland" ]]; then
      captures_bar=$(quickshell ipc -p "${OMARCHY_PATH:-/usr/share/omarchy}/shell/shell.qml" call -- paperlandBar captures "${1:-}" 2>/dev/null) || captures_bar=
      [[ $captures_bar == '{'*'}' ]] || captures_bar='{"bar":{"reachable":false,"reason":"The Omarchy bar host did not answer the captures IPC."}}'
      captures_reply="${captures_reply%\}},${captures_bar#\{}"
    fi
    printf '%s\n' "$captures_reply"
    ;;
  whats-new)
    exec quickshell ipc -p "$paperland_dir/shell.qml" call -- paperland whatsNew "$@"
    ;;
  version)
    version=""
    if [[ -r "$paperland_dir/version.txt" ]]; then version=$(<"$paperland_dir/version.txt"); fi
    version=${version//[[:space:]]/}
    if [[ -z "$version" ]]; then
      echo "Paperland version file is missing: $paperland_dir/version.txt" >&2
      exit 1
    fi
    # Only a checkout rooted here (source) or one level up (Omarchy plugin package)
    # reports a commit; an enclosing dotfiles repository must not.
    commit=""
    for checkout in "$paperland_dir" "$(dirname -- "$paperland_dir")"; do
      if [[ -e "$checkout/.git" ]] && command -v git >/dev/null; then
        commit=$(git -C "$checkout" rev-parse --short HEAD 2>/dev/null) || commit=""
        break
      fi
    done
    echo "Paperland $version${commit:+ ($commit)}"
    ;;
  strip-badges)
    exec quickshell ipc -p "$paperland_dir/shell.qml" call -- paperland stripBadges "$@"
    ;;
  strip-columns)
    exec quickshell ipc -p "$paperland_dir/shell.qml" call -- paperland stripColumns "$@"
    ;;
  switcher-size)
    exec quickshell ipc -p "$paperland_dir/shell.qml" call -- paperland switcherSize "$@"
    ;;
  switcher-all-displays)
    exec quickshell ipc -p "$paperland_dir/shell.qml" call -- paperland switcherAllDisplays "$@"
    ;;
  stop)
    exec quickshell ipc -p "$paperland_dir/shell.qml" call -- paperland quit
    ;;
  names)
    names_action=${1:-}
    if (( $# )); then shift; fi
    case "$names_action" in
      begin)
        if (( $# != 1 )) || [[ ! "$1" =~ ^[1-9][0-9]*$ ]]; then
          echo "Usage: paperland names begin WORKSPACE" >&2
          exit 2
        fi
        names_arg=(paperlandNames begin "$1")
        ;;
      submit)
        if (( $# != 1 )); then
          echo "Usage: paperland names submit JSON" >&2
          exit 2
        fi
        names_arg=(paperlandNames submit "$1")
        ;;
      status)
        if (( $# != 1 )); then
          echo "Usage: paperland names status REQUEST_ID" >&2
          exit 2
        fi
        names_arg=(paperlandNames status "$1")
        ;;
      *)
        echo "Usage: paperland names {begin WORKSPACE|submit JSON|status REQUEST_ID}" >&2
        exit 2
        ;;
    esac

    # Daemonization is idempotent under --no-duplicate; an existing shell is
    # left untouched while a newly started shell receives the hidden startup
    # marker. Each readiness probe is independently bounded.
    timeout --signal=TERM 1s env PAPERLAND_START_HIDDEN=1 QT_QUICK_CONTROLS_STYLE=Basic quickshell --no-duplicate -d -p "$paperland_dir/shell.qml" >/dev/null 2>&1 || true
    names_ready=0
    names_deadline=$((SECONDS + 3))
    while (( SECONDS < names_deadline )); do
      names_reply=""
      if names_reply=$(timeout --signal=TERM 1s quickshell ipc -p "$paperland_dir/shell.qml" call -- paperlandNames ready 2>&1); then :; fi
      if [[ "$names_reply" == "true" ]]; then
        names_ready=1
        break
      fi
      sleep 0.05
    done
    if (( names_ready == 0 )); then
      echo "Paperland workspace-name writer did not become ready within 3 seconds." >&2
      exit 124
    fi
    names_final=""
    names_final_rc=0
    if names_final=$(timeout --signal=TERM 3s quickshell ipc -p "$paperland_dir/shell.qml" call -- "${names_arg[@]}" 2>&1); then
      names_final_rc=0
    else
      names_final_rc=$?
    fi
    printf '%s\n' "$names_final"
    # Structured replies can contain arbitrary label text, including "Error".
    # Only unstructured output is a transport failure; the caller reads JSON status.
    if [[ "$names_final" != \{*\} ]]; then
      if (( names_final_rc == 0 )); then names_final_rc=1; fi
    fi
    exit "$names_final_rc"
    ;;
  *)
    echo "Usage: paperland {install|setup|uninstall|start|start-hidden|demo|show|hide|toggle|search|settings|welcome|whats-new|version|status|captures [detail]|diagnostics|peek on/off/SECONDS|pin true/false|switch-overlay on/off|switcher-size small/medium/large/xl|switcher-all-displays on/off|activate ADDRESS|pan WORKSPACE PIXELS|direction WORKSPACE right/left/up/down/global|instances|stop-safe|names {begin WORKSPACE|submit JSON|status REQUEST_ID}|config {list|get KEY|set KEY VALUE|unset KEY|reload|path}|stop}" >&2
    exit 2
    ;;
esac
